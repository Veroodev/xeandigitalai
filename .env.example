# Salin file ini menjadi .env.local lalu isi API key.
# Jangan pernah memakai prefix NEXT_PUBLIC_ untuk key, agar tidak bocor ke browser.
APMIX_API_KEY=apx_live_isi_key_anda_di_sini

# Base URL provider. Untuk format Anthropic cukup https://api.apmix.ai (tanpa /v1 juga boleh).
APMIX_BASE_URL=https://api.apmix.ai/v1

# Model bawaan jika daftar model gagal diambil.
APMIX_DEFAULT_MODEL=gpt-6-luna-free

# openai (POST /v1/chat/completions) atau anthropic (POST /v1/messages)
APMIX_API_FORMAT=openai
